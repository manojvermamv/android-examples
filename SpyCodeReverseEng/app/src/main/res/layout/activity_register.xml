<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@mipmap/enter_account_bg"
            android:scaleType="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_couple_mask" />

        <View
            android:id="@+id/top_view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/include_actionbar"
            layout="@layout/include_actionbar_login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/actionbar_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_view" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding16"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/padding10"
            app:cardElevation="@dimen/padding6"
            app:layout_constraintBottom_toTopOf="@+id/lay_google_signin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/include_actionbar"
            app:layout_constraintVertical_bias="0.6">

            <FrameLayout
                android:id="@+id/frame_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/lay_google_signin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/loginWithGoogle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/padding42"
                android:layout_marginTop="@dimen/padding20"
                android:background="@drawable/white_rounded_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/padding15"
                android:paddingTop="@dimen/padding5"
                android:paddingEnd="@dimen/padding15"
                android:paddingBottom="@dimen/padding5">

                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="@dimen/padding16"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/google" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/padding8"
                    android:text="Sign in with Google"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/font_sixteen" />
            </LinearLayout>

            <TextView
                android:id="@+id/login_account_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/padding20"
                android:text="Already have an account, Login?"
                android:textColor="@color/black" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>