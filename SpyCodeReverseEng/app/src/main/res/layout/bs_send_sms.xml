<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root">

    <data></data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/back_bottomsheet"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding16">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:text="Send text message"
                android:textColor="@color/black"
                android:textSize="@dimen/font_twenty"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/img_close"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:padding="2dp"
                android:src="@mipmap/ic_close_bs" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding30"
            android:paddingTop="@dimen/padding20"
            android:paddingEnd="@dimen/padding30"
            android:paddingBottom="@dimen/padding20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding12"
                android:text="From Sender"
                android:textSize="@dimen/font_fourteen" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/inputFromSenderId"
                style="@style/Custom.EditTextNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_outline_info_24"
                android:hint="Ex: AM-Amazon"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding12"
                android:layout_marginTop="@dimen/padding18"
                android:text="Recipient numbers"
                android:textSize="@dimen/font_fourteen" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/back_edittext_normal"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/tvCountryCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/inputRecipientNumber"
                    android:layout_alignBottom="@+id/inputRecipientNumber"
                    android:layout_alignParentStart="true"
                    android:background="@color/transparent"
                    android:gravity="center"
                    android:hint="+91"
                    android:inputType="phone"
                    android:maxLength="5"
                    android:paddingStart="@dimen/padding12"
                    android:paddingEnd="@dimen/padding10"
                    android:singleLine="true"
                    android:text="+91"
                    android:textSize="@dimen/font_fifteen" />

                <View
                    android:id="@+id/code_divider"
                    android:layout_width="@dimen/padding1"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/inputRecipientNumber"
                    android:layout_alignBottom="@+id/inputRecipientNumber"
                    android:layout_marginTop="@dimen/padding6"
                    android:layout_marginBottom="@dimen/padding6"
                    android:layout_toEndOf="@+id/tvCountryCode"
                    android:background="@color/grey_400" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/inputRecipientNumber"
                    style="@style/Custom.EditTextNormal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_toEndOf="@+id/code_divider"
                    android:drawableEnd="@drawable/ic_outline_info_24"
                    android:hint="0123456789"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:paddingStart="@dimen/padding10" />

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding12"
                android:layout_marginTop="@dimen/padding18"
                android:text="Message"
                android:textSize="@dimen/font_fourteen" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/inputMessage"
                style="@style/Custom.EditTextNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_outline_info_24"
                android:hint="Ex: Hello friend"
                android:imeOptions="actionNext"
                android:inputType="text" />

            <TextView
                android:id="@+id/inputMessageCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="@color/grey_600"
                android:textSize="11.5sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmit"
                style="@style/ButtonStyle"
                android:layout_width="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/padding25"
                android:layout_marginBottom="@dimen/padding10"
                android:paddingStart="@dimen/padding20"
                android:paddingEnd="@dimen/padding20"
                android:text="Send" />

        </LinearLayout>

    </LinearLayout>

</layout>