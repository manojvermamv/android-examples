<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data></data>

    <RelativeLayout
        android:id="@+id/root_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_main_background_color">

        <include
            android:id="@+id/lay_actionbar"
            layout="@layout/include_actionbar_normal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_bar_height"
            android:layout_alignParentTop="true" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/lay_actionbar">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/deleteButton"
                style="@style/ButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/padding28"
                android:layout_centerHorizontal="true"
                android:layout_marginEnd="@dimen/padding4"
                android:background="@drawable/back_accent_outline"
                android:backgroundTint="@color/red_400"
                android:text="Delete All"
                android:textSize="@dimen/font_fourteen" />

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent">


            </ScrollView>

        </RelativeLayout>

    </RelativeLayout>

</layout>