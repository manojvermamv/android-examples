<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/padding20">

    <com.mikhaellopez.circularimageview.CircularImageView
        android:id="@+id/profile_picture"
        android:layout_width="@dimen/padding80"
        android:layout_height="@dimen/padding80"
        android:layout_marginTop="@dimen/padding20"
        android:elevation="@dimen/padding2"
        android:scaleType="centerCrop"
        android:src="@mipmap/img_avatar_placeholder"
        app:civ_border="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/padding20"
        android:layout_height="@dimen/padding20"
        android:layout_margin="@dimen/padding2"
        android:background="@drawable/circle_shape"
        android:backgroundTint="@color/colorAccent"
        android:elevation="@dimen/padding2"
        android:padding="@dimen/padding4"
        android:src="@drawable/ic_camera_pick_24"
        app:layout_constraintBottom_toBottomOf="@+id/profile_picture"
        app:layout_constraintEnd_toEndOf="@+id/profile_picture"
        app:tint="@color/black" />

    <EditText
        android:id="@+id/email_input"
        style="@style/Custom.EditTextLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding10"
        android:layout_marginTop="@dimen/padding20"
        android:layout_marginEnd="@dimen/padding10"
        android:drawableStart="@drawable/fui_ic_mail_white_24dp"
        android:hint="@string/email"
        android:inputType="textEmailAddress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_picture" />

    <EditText
        android:id="@+id/password_input"
        style="@style/Custom.EditTextLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding10"
        android:layout_marginTop="@dimen/padding20"
        android:layout_marginEnd="@dimen/padding10"
        android:drawableStart="@drawable/ic_baseline_lock_24"
        android:hint="@string/password"
        android:inputType="textPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/email_input" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/next_btn"
        style="@style/LoginButtonStyle"
        android:layout_width="match_parent"
        android:layout_marginStart="@dimen/padding10"
        android:layout_marginTop="@dimen/padding30"
        android:text="@string/next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/password_input" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/padding10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/next_btn" />

</androidx.constraintlayout.widget.ConstraintLayout>