<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root">

    <data></data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding12"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:id="@+id/layDisplayNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/imgUserInfo"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username: "
                android:textColor="@color/black"
                android:textSize="@dimen/font_fifteen" />

            <TextView
                android:id="@+id/displayUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding4"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHighlight="@color/ed_highlight_color"
                android:textIsSelectable="true"
                android:textSize="@dimen/font_fifteen"
                tools:text="Display username" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layUserPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding3"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/imgUserInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layDisplayNameText">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password: "
                android:textColor="@color/black"
                android:textSize="@dimen/font_fifteen" />

            <TextView
                android:id="@+id/displayPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding4"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHighlight="@color/ed_highlight_color"
                android:textIsSelectable="true"
                android:textSize="@dimen/font_fifteen"
                tools:text="Display password" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layIpAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding3"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/imgUserInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layUserPassword">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP Address: "
                android:textColor="@color/black"
                android:textSize="@dimen/font_fifteen" />

            <TextView
                android:id="@+id/displayIpAddr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding4"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHighlight="@color/ed_highlight_color"
                android:textIsSelectable="true"
                android:textSize="@dimen/font_fifteen"
                tools:text="Display IP Address " />

        </LinearLayout>

        <TextView
            android:id="@+id/datetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding3"
            android:gravity="end"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textSize="12.5sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layIpAddress"
            tools:text="Display time" />

        <ImageView
            android:id="@+id/imgUserInfo"
            android:layout_width="@dimen/padding28"
            android:layout_height="@dimen/padding28"
            android:layout_margin="@dimen/padding5"
            android:src="@drawable/ic_outline_info_24"
            app:layout_constraintBottom_toTopOf="@+id/datetime"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/grey_500" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>