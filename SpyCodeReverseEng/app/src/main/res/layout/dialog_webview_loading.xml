<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/back_cardview"
    android:padding="@dimen/padding8">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/title_bg"
        android:layout_alignBottom="@+id/lay_card"
        android:scrollbars="none"
        tools:ignore="WebViewLayout" />

    <View
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/webView"
        android:layout_alignBottom="@+id/webView"
        android:background="@color/white" />

    <RelativeLayout
        android:id="@+id/title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:padding="@dimen/padding12"
            android:text="Loading.."
            android:textColor="@color/black"
            android:textSize="@dimen/font_twenty" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/lay_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title_bg"
        android:layout_centerHorizontal="true"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="@dimen/padding40"
            android:layout_height="@dimen/padding40"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/padding16"
            android:layout_marginTop="@dimen/padding16"
            android:layout_marginEnd="@dimen/padding16"
            android:layout_marginBottom="@dimen/padding16"
            android:indeterminate="true"
            android:indeterminateTint="@color/colorAccent"
            android:indeterminateTintMode="src_atop" />

        <TextView
            android:id="@+id/dialog_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/padding10"
            android:layout_toEndOf="@+id/progress_loading"
            android:singleLine="true"
            android:text="Wait a moment"
            android:textColor="@color/black"
            android:textSize="@dimen/font_sixteen" />

    </RelativeLayout>

</RelativeLayout>